msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Reanomena els fitxers en baixar-los"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Substitueix el nom del fitxer lliurat en baixar-lo. Format per defecte: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Opcionalment, només números: {submissionId}-{submissionFileId}.{ext}. Ni el fitxer del disc ni el nom de la interfície editorial no canvien."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Trieu el format del nom del fitxer que s'envia a l'usuari quan es baixa un fitxer d'una tramesa. El fitxer emmagatzemat al servidor i el nom que es mostra a la interfície editorial no canvien."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Només números — utilitza {submissionId}-{submissionFileId}.{ext} en lloc de submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
