msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "Canvia el Nom dels Fitxers en Baixar-los"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Lliura els fitxers de la tramesa amb un nom neutre i normalitzat en baixar-los, com tramesa-123-fitxer-456.pdf, en la llengua de qui els baixa o de la revista, o només amb números. El fitxer emmagatzemat i el nom que es mostra a la interfície editorial no canvien."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Trieu com s'anomenen els fitxers de la tramesa quan algú els baixa. El fitxer emmagatzemat al servidor i el nom que es mostra a la interfície editorial no canvien."

msgid "plugins.generic.ojsbrFilenameRename.settings.format"
msgstr "Format del nom del fitxer"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.descriptive"
msgstr "Nom descriptiu: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.numbersOnly"
msgstr "Només números: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.language"
msgstr "Llengua del nom descriptiu"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.description"
msgstr "No s'aplica al format de només números. Una llengua sense aquesta traducció fa servir l'anglès."

msgid "plugins.generic.ojsbrFilenameRename.settings.language.user"
msgstr "Llengua de la interfície de qui baixa el fitxer"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.context"
msgstr "Llengua principal de la revista, {$language}: {$example}"

#. File name delivered on download, without the extension. Keep both placeholders.
#. Latin-script languages: lowercase letters without diacritics, digits and hyphens only.
msgid "plugins.generic.ojsbrFilenameRename.filename.descriptive"
msgstr "tramesa-{$submissionId}-fitxer-{$submissionFileId}"
