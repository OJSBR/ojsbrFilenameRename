msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Dateien beim Download umbenennen"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Ersetzt den beim Download gelieferten Dateinamen. Standardformat: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Optional nur Zahlen: {submissionId}-{submissionFileId}.{ext}. Die Datei auf dem Datenträger und der Name in der redaktionellen Oberfläche werden nicht geändert."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Wählen Sie das Format des Dateinamens, der an die Benutzer gesendet wird, wenn eine Einreichungsdatei heruntergeladen wird. Die auf dem Server gespeicherte Datei und der in der redaktionellen Oberfläche angezeigte Name bleiben unverändert."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Nur Zahlen — {submissionId}-{submissionFileId}.{ext} anstelle von submissao-{submissionId}-arquivo-{submissionFileId}.{ext} verwenden"
