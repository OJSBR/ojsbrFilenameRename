msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "Dateien beim Download umbenennen"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Liefert die Dateien einer Einreichung beim Download unter einem neutralen, einheitlichen Namen aus, zum Beispiel einreichung-123-datei-456.pdf, in der Sprache der herunterladenden Person oder der Zeitschrift, oder nur mit Zahlen. Die gespeicherte Datei und der in der redaktionellen Oberfläche angezeigte Name bleiben unverändert."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Legen Sie fest, wie die Dateien einer Einreichung beim Herunterladen benannt werden. Die auf dem Server gespeicherte Datei und der in der redaktionellen Oberfläche angezeigte Name bleiben unverändert."

msgid "plugins.generic.ojsbrFilenameRename.settings.format"
msgstr "Format des Dateinamens"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.descriptive"
msgstr "Beschreibender Name: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.numbersOnly"
msgstr "Nur Zahlen: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.language"
msgstr "Sprache des beschreibenden Namens"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.description"
msgstr "Gilt nicht für das Format mit nur Zahlen. Eine Sprache ohne diese Übersetzung verwendet Englisch."

msgid "plugins.generic.ojsbrFilenameRename.settings.language.user"
msgstr "Oberflächensprache der herunterladenden Person"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.context"
msgstr "Hauptsprache der Zeitschrift, {$language}: {$example}"

#. File name delivered on download, without the extension. Keep both placeholders.
#. Latin-script languages: lowercase letters without diacritics, digits and hyphens only.
msgid "plugins.generic.ojsbrFilenameRename.filename.descriptive"
msgstr "einreichung-{$submissionId}-datei-{$submissionFileId}"
