msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "Rename Files on Download"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Delivers submission files under a neutral, standardized name on download, such as submission-123-file-456.pdf, in the language of the person downloading or of the journal, or as numbers only. The stored file and the name shown in the editorial interface are not changed."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Choose how submission files are named when someone downloads them. The file stored on the server and the name shown in the editorial interface are not changed."

msgid "plugins.generic.ojsbrFilenameRename.settings.format"
msgstr "File name format"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.descriptive"
msgstr "Descriptive name: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.numbersOnly"
msgstr "Numbers only: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.language"
msgstr "Language of the descriptive name"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.description"
msgstr "Does not apply to the numbers-only format. A language without this translation falls back to English."

msgid "plugins.generic.ojsbrFilenameRename.settings.language.user"
msgstr "Interface language of the person downloading"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.context"
msgstr "Primary language of the journal, {$language}: {$example}"

#. File name delivered on download, without the extension. Keep both placeholders.
#. Latin-script languages: lowercase letters without diacritics, digits and hyphens only.
msgid "plugins.generic.ojsbrFilenameRename.filename.descriptive"
msgstr "submission-{$submissionId}-file-{$submissionFileId}"
