msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Renombrar archivos al descargar"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Reemplaza el nombre del archivo entregado en la descarga. Formato predeterminado: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Opcionalmente, solo números: {submissionId}-{submissionFileId}.{ext}. El archivo en disco y el nombre en la interfaz editorial no se modifican."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Elija el formato del nombre de archivo enviado al usuario cuando se descarga un archivo de envío. El archivo almacenado en el servidor y el nombre mostrado en la interfaz editorial permanecen sin cambios."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Solo números — usar {submissionId}-{submissionFileId}.{ext} en lugar de submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
