msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "Renommer les Fichiers au Téléchargement"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Fournit les fichiers de la soumission sous un nom neutre et normalisé au téléchargement, par exemple soumission-123-fichier-456.pdf, dans la langue de la personne qui télécharge ou de la revue, ou uniquement avec des chiffres. Le fichier stocké et le nom affiché dans l'interface éditoriale ne sont pas modifiés."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Choisissez comment les fichiers de la soumission sont nommés lorsqu'une personne les télécharge. Le fichier stocké sur le serveur et le nom affiché dans l'interface éditoriale ne sont pas modifiés."

msgid "plugins.generic.ojsbrFilenameRename.settings.format"
msgstr "Format du nom de fichier"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.descriptive"
msgstr "Nom descriptif : {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.numbersOnly"
msgstr "Chiffres uniquement : {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.language"
msgstr "Langue du nom descriptif"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.description"
msgstr "Ne s'applique pas au format avec chiffres uniquement. Une langue sans cette traduction utilise l'anglais."

msgid "plugins.generic.ojsbrFilenameRename.settings.language.user"
msgstr "Langue de l'interface de la personne qui télécharge"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.context"
msgstr "Langue principale de la revue, {$language} : {$example}"

#. File name delivered on download, without the extension. Keep both placeholders.
#. Latin-script languages: lowercase letters without diacritics, digits and hyphens only.
msgid "plugins.generic.ojsbrFilenameRename.filename.descriptive"
msgstr "soumission-{$submissionId}-fichier-{$submissionFileId}"
