msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Renommer les fichiers au téléchargement"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Remplace le nom du fichier livré au téléchargement. Format par défaut : submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Facultativement, chiffres seulement : {submissionId}-{submissionFileId}.{ext}. Le fichier sur le disque et le nom dans l'interface éditoriale ne changent pas."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Choisissez le format du nom de fichier envoyé à l'utilisateur lors du téléchargement d'un fichier de soumission. Le fichier stocké sur le serveur et le nom affiché dans l'interface éditoriale restent inchangés."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Chiffres seulement — utiliser {submissionId}-{submissionFileId}.{ext} au lieu de submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
