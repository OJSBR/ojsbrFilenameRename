msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Renomear os ficheiros ao descargalos"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Substitúe o nome do ficheiro entregado na descarga. Formato predeterminado: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Opcionalmente, só números: {submissionId}-{submissionFileId}.{ext}. Nin o ficheiro do disco nin o nome da interface editorial cambian."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Escolla o formato do nome de ficheiro que se envía á persoa usuaria ao descargar un ficheiro dun envío. O ficheiro gardado no servidor e o nome que se amosa na interface editorial non cambian."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Só números — usar {submissionId}-{submissionFileId}.{ext} en lugar de submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
