msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "Rinomina i File al Download"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Consegna i file della proposta con un nome neutro e uniforme al download, ad esempio proposta-123-file-456.pdf, nella lingua di chi scarica o della rivista, oppure solo con numeri. Il file archiviato e il nome mostrato nell'interfaccia editoriale non vengono modificati."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Scegli come vengono nominati i file della proposta quando qualcuno li scarica. Il file archiviato sul server e il nome mostrato nell'interfaccia editoriale non vengono modificati."

msgid "plugins.generic.ojsbrFilenameRename.settings.format"
msgstr "Formato del nome del file"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.descriptive"
msgstr "Nome descrittivo: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.format.numbersOnly"
msgstr "Solo numeri: {$example}"

msgid "plugins.generic.ojsbrFilenameRename.settings.language"
msgstr "Lingua del nome descrittivo"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.description"
msgstr "Non si applica al formato con soli numeri. Una lingua senza questa traduzione usa l'inglese."

msgid "plugins.generic.ojsbrFilenameRename.settings.language.user"
msgstr "Lingua dell'interfaccia di chi scarica"

msgid "plugins.generic.ojsbrFilenameRename.settings.language.context"
msgstr "Lingua principale della rivista, {$language}: {$example}"

#. File name delivered on download, without the extension. Keep both placeholders.
#. Latin-script languages: lowercase letters without diacritics, digits and hyphens only.
msgid "plugins.generic.ojsbrFilenameRename.filename.descriptive"
msgstr "proposta-{$submissionId}-file-{$submissionFileId}"
