msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Rinomina i file al download"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Sostituisce il nome del file fornito durante il download. Formato predefinito: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. In alternativa, solo numeri: {submissionId}-{submissionFileId}.{ext}. Il file su disco e il nome nell'interfaccia editoriale non vengono modificati."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Scegli il formato del nome del file inviato all'utente quando viene scaricato un file di una proposta. Il file archiviato sul server e il nome mostrato nell'interfaccia editoriale rimangono invariati."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Solo numeri — usa {submissionId}-{submissionFileId}.{ext} invece di submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
