msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Bestanden hernoemen bij downloaden"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Vervangt de bestandsnaam die bij het downloaden wordt geleverd. Standaardindeling: submissao-{submissionId}-arquivo-{submissionFileId}.{ext}. Optioneel alleen cijfers: {submissionId}-{submissionFileId}.{ext}. Het bestand op schijf en de naam in de redactionele interface veranderen niet."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Kies de indeling van de bestandsnaam die de gebruiker krijgt bij het downloaden van een inzendingsbestand. Het bestand op de server en de naam in de redactionele interface blijven ongewijzigd."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Alleen cijfers — gebruik {submissionId}-{submissionFileId}.{ext} in plaats van submissao-{submissionId}-arquivo-{submissionFileId}.{ext}"
