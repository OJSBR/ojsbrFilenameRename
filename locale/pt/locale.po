msgid "plugins.generic.ojsbrFilenameRename.displayName"
msgstr "OJSBR — Renomear ficheiros na transferência"

msgid "plugins.generic.ojsbrFilenameRename.description"
msgstr "Substitui o nome do ficheiro entregue ao utilizador na transferência. Formato padrão: submissao-{ID}-arquivo-{ID}.{ext}. Opcionalmente, apenas números: {ID}-{ID}.{ext}. Não altera o ficheiro no servidor nem o nome apresentado na interface editorial."

msgid "plugins.generic.ojsbrFilenameRename.settings.description"
msgstr "Escolha o formato do nome do ficheiro enviado ao utilizador quando um ficheiro de submissão é transferido. O ficheiro no servidor e o nome apresentado na interface editorial não são alterados."

msgid "plugins.generic.ojsbrFilenameRename.settings.numbersOnly.label"
msgstr "Apenas números — utilizar {ID-submissao}-{ID-arquivo}.{ext} em vez de submissao-{ID}-arquivo-{ID}.{ext}"
